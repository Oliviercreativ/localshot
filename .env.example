# Configuration du serveur LocalShot — copiez ce fichier en « .env » puis : npm run start:env (ou docker compose up -d)
# (sur le Raspberry Pi, deploy/pi/install.sh écrit ces valeurs dans /etc/localshot.env)

# ---- Accès ----
# Clé exigée pour lister / envoyer / supprimer (obligatoire dès que le serveur est joignable par d'autres appareils).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LOCALSHOT_TOKEN=
# Adresse publique du serveur (Host/Origin acceptés, base des liens de partage)
LOCALSHOT_PUBLIC_URL=https://pi.votre-tailnet.ts.net
# Dossier de la liste des partages (et des fichiers si STORAGE=local)
LOCALSHOT_DATA=./data
PORT=4777
# Adresse d'écoute (127.0.0.1 par défaut ; le conteneur Docker utilise 0.0.0.0)
# LOCALSHOT_HOST=127.0.0.1

# ---- Stockage des fichiers : local | s3 ----
STORAGE=local

# STORAGE=s3 — fonctionne avec AWS S3, Cloudflare R2, Backblaze B2, Scaleway, OVH, Wasabi, MinIO, Garage…
# Le bucket reste privé : les vidéos sont lues via des liens temporaires signés.
# Donnez à la clé uniquement les droits lecture / écriture / suppression sur ce bucket.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cloudflare R2 : https://<id-du-compte>.r2.cloudflarestorage.com   (vide = AWS S3)
S3_ENDPOINT=
# eu-west-3, fr-par… ; « auto » pour R2 (déduit automatiquement)
S3_REGION=
# Dossier dans le bucket (optionnel)
S3_PREFIX=localshot
# Validité des liens de lecture, en secondes (défaut 6 h)
S3_URL_TTL=21600
