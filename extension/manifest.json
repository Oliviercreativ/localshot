{
  "manifest_version": 3,
  "name": "LocalShot — captures 100 % locales",
  "version": "0.8.0",
  "description": "Captures d'écran et vidéos (onglet, fenêtre, écran) stockées uniquement dans votre navigateur.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "unlimitedStorage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:4777/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LocalShot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Capturer la partie visible"
    },
    "capture-full": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Capturer la page entière"
    },
    "capture-area": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capturer une zone sélectionnée"
    },
    "record-video": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Démarrer / arrêter un enregistrement vidéo"
    }
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
